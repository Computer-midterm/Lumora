{
  "name": "lumora-landing",
  "private": true,
  "version": "0.1.0",
  "description": "Lumora (working name) marketing landing page. Local only: not deployed, no backend, no data collection.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "frames": "node scripts/build-frames.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "screenshots": "node scripts/screenshots.mjs",
    "upscale": "node scripts/upscale-frames.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "playwright-core": "1.64.1"
  }
}
